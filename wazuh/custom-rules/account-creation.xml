<!--
  Custom Wazuh rule for Windows user account creation.

  Windows Security Event ID 4720 means a user account was created.
  This is a lab rule. Test it with the actual event data from your
  Wazuh installation before using it in another environment.
-->
<group name="windows,account_creation,custom,">

  <rule id="100100" level="8">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^4720$</field>
    <description>Windows: A new user account was created.</description>
    <group>account_creation,windows,</group>
    <mitre>
      <id>T1136</id>
    </mitre>
  </rule>

</group>
