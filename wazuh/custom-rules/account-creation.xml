<!--
  Example custom Wazuh rule for Windows account-creation activity.

  Important:
  The exact Windows event fields can vary depending on the event data
  collected by the Wazuh agent. Test the rule with the actual event from
  the lab before using it.
-->

<group name="windows,account_creation,custom,">
  <rule id="100100" level="10">
    <if_group>windows</if_group>
    <field name="win.system.eventID">4720</field>
    <description>Windows user account was created</description>
    <group>account_creation,windows,</group>
  </rule>
</group>
